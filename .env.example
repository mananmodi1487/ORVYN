# ORVYN — environment template
#
# This file is committed to git. Never commit real secrets or `.env.local`.
#
# Copy it to `.env.local` when a variable is needed:
#   cp .env.example .env.local   (macOS / Linux)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#
# `.env.local` is gitignored; this template is tracked.

# --- Supabase -------------------------------------------------------------
# Both values are safe to expose to the browser: the `NEXT_PUBLIC_` prefix
# inlines them into the client bundle, which is only acceptable because the
# publishable key is a public, RLS-protected credential.
#
# Project URL  — Supabase dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
#
# Publishable key — Supabase dashboard → Project Settings → API Keys
# Use the *publishable* key. Never add the secret / service-role key here: any
# `NEXT_PUBLIC_` value ships to the browser and would leak full database access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Site -----------------------------------------------------------------
# Absolute origin used for `metadataBase`. Optional; defaults to localhost.
NEXT_PUBLIC_SITE_URL=

# --- AI providers ---------------------------------------------------------
# Both values of a pair are required together: a base URL without a key would
# send unauthenticated requests, and a key without a base URL has nowhere to go.
# A provider missing either value is reported as unconfigured and is never
# contacted — it is not treated as "down".
#
# Never prefix these with `NEXT_PUBLIC_`. A prefixed value is inlined into the
# browser bundle, which would ship every provider key to clients. These are read
# only from server code.
#
# OmniRoute
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
#
# FreeLLMAPI
FREE_LLM_API_BASE_URL=
FREE_LLM_API_KEY=
#
# Groq — first production provider. Sign up at groq.com for a free API key.
# The free tier is rate-limited, not credit-based: no card, no per-token charge.
# Verified against Groq's docs: OpenAI-compatible at https://api.groq.com/openai/v1,
# free models include llama-3.3-70b-versatile (131K context, 32K output).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# --- Usage accounting ------------------------------------------------------
# Signs each usage row so the database can tell a genuine write from a forged
# one. ORVYN's chat route signs the exact row it wants written, using the token
# counts it read out of the provider response; the database verifies that
# signature before inserting.
#
# The browser cannot write usage rows at all — the table has no INSERT grant for
# `anon` or `authenticated`, and the recording function rejects any call whose
# signature it cannot verify. That is why this secret must stay server-side: if
# it reached the browser, every user could sign their own token counts.
#
# Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# Then provision the same value in the database (SQL editor, as the project
# owner):
#   select private.set_usage_signing_secret('<the value you generated>');
#
# With this unset, usage is not recorded and the UI reports "usage unavailable".
# That is the safe direction: no rows, rather than unsigned ones.
#
# Never prefix this with `NEXT_PUBLIC_`.
ORVYN_USAGE_SIGNING_SECRET=

# --- AI model declarations -------------------------------------------------
# Which discovered models are actually routable, and with what capabilities,
# price, context limits, and priority. Everything here is operator-declared: a
# model absent from this configuration stays unknown and is never routed to.
#
# Point at a JSON file (recommended — keeps the set in version control):
#   ORVYN_AI_DECLARATIONS_PATH=ai.models.json
# or supply the document inline (useful for a small container override):
#   ORVYN_AI_DECLARATIONS_JSON={"models":[]}
#
# `ORVYN_AI_DECLARATIONS_PATH` wins when both are set. An unset or blank value
# means "no declarations", which is the safe default.
#
# Never prefix these with `NEXT_PUBLIC_`. Declarations decide routing, and a
# client-visible declaration set leaks deployment configuration even when it
# holds no credentials. They are read only from server code.
ORVYN_AI_DECLARATIONS_PATH=
ORVYN_AI_DECLARATIONS_JSON=